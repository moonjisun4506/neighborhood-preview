# Browser-visible JavaScript key; restrict allowed web domains in Kakao Developers.
NEXT_PUBLIC_KAKAO_JS_KEY=
# Server-only REST key. Never prefix this variable with NEXT_PUBLIC_.
KAKAO_REST_API_KEY=
# ODsay Server-platform key, with this server's public egress IP registered.
# Keep any existing ODSAY_API_KEY Web-platform key separate; do not expose it automatically.
ODSAY_SERVER_API_KEY=
# Web/URI mode: PUBLIC Web key only; register the actual browser origin with ODsay.
# Do not put a Server-platform key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TRANSIT_MODE=web
NEXT_PUBLIC_ODSAY_WEB_API_KEY=

# Server-only MOLIT key; activate SHRent, RHRent and OffiRent APIs.
MOLIT_API_KEY=

# Server-only Neon PostgreSQL connection string.
DATABASE_URL=

# Server-only OpenAI Responses API settings.
OPENAI_API_KEY=
OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# Server-only Safemap WMS service key. IF_0087_WMS data approval may be separate.
SAFEMAP_API_KEY=
